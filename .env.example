# ---------------------------------------------------------------------------
# creaDIG — Umgebungsvariablen
#
# Diese Datei ist eine VORLAGE und enthaelt keine echten Werte.
# Die echten Werte stehen in Vercel unter Settings -> Environment Variables.
# Niemals eine ausgefuellte .env ins Repo legen.
# ---------------------------------------------------------------------------

# Der Lead-Weg (app/api/lead). Ohne diese beiden Werte antwortet die Route
# mit 503 und das Formular zeigt WhatsApp und E-Mail als Weg an — es meldet
# NIE einen Erfolg, den es nicht gab.
#
# Schluessel: https://resend.com/api-keys
RESEND_API_KEY=

# Absender. Muss eine bei Resend verifizierte Domain sein, sonst lehnt der
# Versand ab. Beispiel: creaDIG <anfrage@creadig.de>
LEAD_FROM=

# Empfaenger der Anfragen. Standard ist info@creadig.de, wenn leer.
LEAD_TO=info@creadig.de

# BF-2 — Geheimnis fuer das signierte Zeit-Token des Formulars und fuer den
# Hash der Absender-Adresse im IP-Fenster (lib/lead-guard.ts). OPTIONAL: Bleibt
# der Wert leer, wird RESEND_API_KEY verwendet. Ein eigener Wert ist trotzdem
# besser — dann muss beim Wechsel des Resend-Schluessels kein offenes Formular
# ungueltig werden. Irgendeine lange Zufallszeichenkette, z. B.
#   openssl rand -base64 32
LEAD_TOKEN_SECRET=

# BF-8 — Zustell-Selbsttest (app/api/selftest).
#
# Ohne SELFTEST_SECRET ist die Route abgeschaltet und antwortet mit 503.
# Mit gesetztem Wert prueft sie Schluessel, Absender-Domain und die
# Token-Kette — ohne eine Mail zu verschicken. Aufruf:
#
#   curl -H "x-selftest-key: $SELFTEST_SECRET" https://creadig.de/api/selftest
#   ...?send=1   verschickt zusaetzlich EINE Testmail an LEAD_TO
#
# Antwort 200 = alles steht, 503 = gestoert. AKTIVIERUNG IST OWNER-SACHE:
# Der Code laeuft, aber jemand muss ihn regelmaessig aufrufen — Vercel Cron
# (vercel.json), ein Uptime-Dienst oder ein Cron auf einem eigenen Rechner.
SELFTEST_SECRET=

# T-2 — Alarmweg fuer alles, was jemanden erreichen MUSS: eine URL, die eine
# kurze JSON-Meldung {"text": "..."} entgegennimmt (Slack-/Discord-Webhook
# o. ae.). Gemeldet werden:
#   - Lead-Route nicht konfiguriert  (jede Anfrage geht verloren)
#   - Zustellung an das eigene Postfach fehlgeschlagen (Anfrage verloren)
#   - Eingangsbestaetigung fehlgeschlagen (niedrigere Stufe)
#   - CSP-Verstoss, der bei scharfer Policy tatsaechlich geblockt hat
#   - fehlgeschlagener Zustell-Selbsttest
# Gedrosselt auf eine Meldung je Art und 15 Minuten (lib/alert.ts).
#
# Leer lassen ist in Ordnung: Dann bleibt es bei `[alarm]`-Zeilen im
# Vercel-Log — aber die sieht nur, wer hinsieht.
ALERT_WEBHOOK_URL=

# BF-7 — Content-Security-Policy scharf stellen.
#
# Leer/ungesetzt: Die vollstaendige Policy laeuft nur als Bericht
# (Content-Security-Policy-Report-Only), scharf sind nur object-src, base-uri,
# form-action und frame-ancestors.
#
# CSP_ENFORCE=1: Die vollstaendige Policy gilt und blockiert — fremde
# Skript-Hosts, fremde Verbindungsziele, Frames, Schriften und Bilder von
# ueberall her. Inline-Skripte bleiben erlaubt (Begruendung in next.config.ts).
#
# REIHENFOLGE (Live-Checkliste): erst ein paar Tage die Berichte in
# app/api/csp-report ansehen, dann umlegen. Nicht umgekehrt.
#
# ACHTUNG: Die Kopfzeilen entstehen beim BAUEN (next.config.ts `headers()`).
# Der Wert muss also vor dem Build gesetzt sein — ein Umlegen in Vercel
# wirkt erst nach einem neuen Deployment.
CSP_ENFORCE=

# Oeffentliche Basis-Adresse fuer Sitemap, robots, Canonicals und OG-Bilder.
# Solange creadig.de nicht auf das Vercel-Projekt zeigt, hier die
# vercel.app-Adresse eintragen — sonst liefern diese Dateien eine Adresse
# aus, die das Projekt gar nicht bedient.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────
# CONTROL CENTER (MP-G · /admin)
# ─────────────────────────────────────────────────────────────────────────
#
# BEIDE Werte oder keiner. Fehlt einer, antwortet alles unter /admin mit 404
# — es gibt dann kein Anmeldeformular, das verraet, dass hier etwas liegt.
# Das ist Absicht: lieber kein Control Center als ein ungesichertes.
#
# ADMIN_PASSWORD
#   Das Passwort. Ein langer, zufaelliger Wert — es gibt keinen Nutzernamen
#   davor, also traegt dieser Wert die ganze Tuer.
#
# ADMIN_SESSION_SECRET
#   Signiert das Sitzungs-Cookie. BEWUSST ein eigener Wert und kein Rueckfall
#   auf RESEND_API_KEY oder LEAD_TOKEN_SECRET: Jene schuetzen ein
#   oeffentliches Formular gegen Missbrauch, dieser den Zugang zu allem. Ein
#   Geheimnis fuer zwei Zwecke ist beim Wechsel doppelt gefaehrlich.
#
# Erzeugen (beide getrennt):
#   openssl rand -base64 32
#
# Wer den Wert aendert, meldet alle offenen Sitzungen ab. Das ist der
# Not-Aus.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
