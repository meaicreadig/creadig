{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/messen/radar",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/assistent/truppe",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/assistent/puls?runde=mittag",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/assistent/puls?runde=nachmittag",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/selftest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/motor/takt",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/finanz/abgleich",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/assistent/abend",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/finanz/morgenmail",
      "schedule": "15 6 * * *"
    }
  ]
}
