{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/selftest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/motor/takt",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/finanz/abgleich",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/finanz/morgenmail",
      "schedule": "15 6 * * *"
    }
  ]
}
